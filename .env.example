# Docker Desktop (Linux containers) running on the ADR Windows computer.
ADR_GATEWAY_IMAGE=adr-gateway:local
GATEWAY_PORT=18081
ADR_BASE_URL=http://host.docker.internal:18080/api/v1
# Both refer to exactly the same folder. Use forward slashes in this file.
ADR_SAVE_ROOT=D:/ADR_Data
CAPTURE_HOST_DIR=D:/ADR_Data
